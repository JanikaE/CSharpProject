<UserControl
    x:Class="UsefulTools.Tabs.BackupTab"
    x:Name="BackupTabRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tabs="using:UsefulTools.Tabs">

    <UserControl.Resources>
        <tabs:BackupPolicyConverter x:Key="BackupPolicyConverter"/>
    </UserControl.Resources>

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：配置面板 -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="BackupErrorTextBlock" Grid.Row="0"
                       Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- 路径对列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PathPairItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                    Padding="8" Margin="0,0,0,8">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Policy, Converter={StaticResource BackupPolicyConverter}}"
                                                   Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TargetPath}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="打开源" Tag="{Binding}"
                                                Click="OpenSourcePath_Click" Padding="8,4"/>
                                        <Button Content="打开目标" Tag="{Binding}"
                                                Click="OpenTargetPath_Click" Padding="8,4"/>
                                        <Button Content="编辑" Tag="{Binding}"
                                                IsEnabled="{Binding CanModify, ElementName=BackupTabRoot}"
                                                Click="EditPathPair_Click" Padding="8,4"/>
                                        <Button Content="执行单项" Tag="{Binding}"
                                                IsEnabled="{Binding CanExecute, ElementName=BackupTabRoot}"
                                                Click="ExecOne_Click" Padding="8,4"/>
                                        <Button Content="删除" Tag="{Binding}"
                                                IsEnabled="{Binding CanModify, ElementName=BackupTabRoot}"
                                                Click="DeletePathPair_Click" Padding="8,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部：添加按钮 + 忽略 + 执行 -->
            <Grid Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BackupAddButton" Content="添加路径"
                            IsEnabled="{Binding CanModify, ElementName=BackupTabRoot}"
                            Click="AddPathPair_Click" Padding="16,8"/>
                    <CheckBox x:Name="BackupShowIgnoreCheckBox" Content="显示忽略项"
                              Checked="IsShowIgnore_Changed" Unchecked="IsShowIgnore_Changed"/>
                </StackPanel>

                <Button x:Name="BackupExecButton" Grid.Row="1"
                        Content="执行备份" HorizontalAlignment="Right" Padding="16,8"
                        IsEnabled="{Binding CanExecute, ElementName=BackupTabRoot}"
                        Click="ExecBackup_Click"/>
            </Grid>
        </Grid>

        <!-- 右侧：备份结果列表 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="备份结果" FontWeight="Bold"/>
                <StackPanel x:Name="BackupStatusPanel" Orientation="Horizontal" Spacing="6"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="BackupProgressRing" Width="16" Height="16"
                                  IsActive="True"/>
                    <TextBlock x:Name="BackupStatusTextBlock" Text="正在备份..."
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <ListView x:Name="BackupResultListView" Grid.Row="1"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                            <TextBlock.Foreground>
                                <Binding Path="Type">
                                    <Binding.Converter>
                                        <tabs:BackupResultColorConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="BackupClearButton" Grid.Row="2"
                    Content="清空结果" HorizontalAlignment="Right" Padding="16,8"
                    IsEnabled="{Binding CanModify, ElementName=BackupTabRoot}"
                    Click="ClearResults_Click"/>
        </Grid>
    </Grid>
</UserControl>