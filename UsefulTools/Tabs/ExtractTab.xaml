<UserControl
    x:Class="UsefulTools.Tabs.ExtractTab"
    x:Name="ExtractTabRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tabs="using:UsefulTools.Tabs">

    <UserControl.Resources>
        <tabs:ExtractStateConverter x:Key="ExtractStateConverter"/>
        <tabs:ExtractStateColorConverter x:Key="ExtractStateColorConverter"/>
    </UserControl.Resources>

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：压缩包选择 + 解压设置 -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ExtractErrorTextBlock" Grid.Row="0"
                       Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- 目标文件夹 -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExtractTargetTextBox" Grid.Column="0"
                         Header="解压目标文件夹"
                         PlaceholderText="请选择要解压到的目标文件夹..."
                         IsReadOnly="True"
                         Text="{x:Bind TargetFolder, Mode=OneWay}"/>
                <Button Grid.Column="1" Content="选择..." VerticalAlignment="Bottom" Padding="16,8"
                        IsEnabled="{Binding CanModify, ElementName=ExtractTabRoot}"
                        Click="PickTargetFolder_Click"/>
            </Grid>

            <ComboBox x:Name="ExtractModeComboBox" Grid.Row="2"
                      Header="并发模式"
                      SelectionChanged="ExtractMode_Changed">
                <ComboBoxItem Content="自动（按磁盘类型）"/>
                <ComboBoxItem Content="单包顺序"/>
                <ComboBoxItem Content="多包并行"/>
            </ComboBox>

            <StackPanel Grid.Row="3" Spacing="4">
                <CheckBox x:Name="ExtractSubfolderCheckBox"
                          Content="解压到与压缩包同名的子文件夹"
                          Checked="ExtractSubfolder_Changed" Unchecked="ExtractSubfolder_Changed"/>
                <CheckBox x:Name="ExtractDeleteArchiveCheckBox" Content="解压完成后删除压缩包"
                          ToolTipService.ToolTip="成功解压后将原压缩包移至回收站"
                          IsEnabled="{Binding CanModify, ElementName=ExtractTabRoot}"
                          Checked="ExtractDeleteArchive_Changed" Unchecked="ExtractDeleteArchive_Changed"/>
            </StackPanel>

            <!-- 已选压缩包列表 -->
            <Grid Grid.Row="4" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="已选压缩包" FontWeight="Bold"/>

                <ListView x:Name="ExtractArchiveListView" Grid.Row="1"
                          SelectionMode="Multiple">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                    Padding="8" Margin="0,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="Gray"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 批量操作 + 开始解压 -->
            <Grid Grid.Row="5" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="添加压缩包" Click="AddArchives_Click" Padding="16,8"
                            IsEnabled="{Binding CanModify, ElementName=ExtractTabRoot}"/>
                    <Button Content="移除选中" Click="RemoveSelected_Click" Padding="16,8"
                            IsEnabled="{Binding CanModify, ElementName=ExtractTabRoot}"/>
                    <Button Content="清空" Click="ClearArchives_Click" Padding="16,8"
                            IsEnabled="{Binding CanModify, ElementName=ExtractTabRoot}"/>
                </StackPanel>

                <Button x:Name="ExtractRunButton" Grid.Row="1"
                        Content="开始解压" HorizontalAlignment="Right" Padding="16,8"
                        IsEnabled="{Binding CanExecute, ElementName=ExtractTabRoot}"
                        Click="RunExtract_Click"/>
            </Grid>
        </Grid>

        <!-- 右侧：每个压缩包的解压进度 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="解压进度" FontWeight="Bold"/>
                <StackPanel x:Name="ExtractStatusPanel" Orientation="Horizontal" Spacing="6"
                            Visibility="Collapsed">
                    <ProgressRing Width="16" Height="16" IsActive="True"/>
                    <TextBlock x:Name="ExtractStatusTextBlock" Text="正在解压..."
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <ListView x:Name="ExtractProgressListView" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowSpacing="2" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding State, Converter={StaticResource ExtractStateConverter}}">
                                    <TextBlock.Foreground>
                                        <Binding Path="State" Converter="{StaticResource ExtractStateColorConverter}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>

                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                         Value="{Binding Progress}" Height="6"/>
                            <TextBlock Grid.Row="2" Text="{Binding Message}"
                                       FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="ExtractClearResultButton" Grid.Row="2"
                    Content="清空结果" HorizontalAlignment="Right" Padding="16,8"
                    IsEnabled="{Binding CanModify, ElementName=ExtractTabRoot}"
                    Click="ClearProgress_Click"/>
        </Grid>
    </Grid>
</UserControl>