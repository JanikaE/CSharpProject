<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UsefulTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tabs="using:UsefulTools.Tabs"
    xmlns:tb="using:H.NotifyIcon"
    Title="UsefulTools">

    <Grid>
        <controls:TabView x:Name="MainTabView" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <controls:TabView.TabItems>
                <controls:TabViewItem x:Name="Base64TabItem" Header="base64解码" IsClosable="False">
                    <controls:TabViewItem.IconSource>
                        <controls:SymbolIconSource Symbol="Pictures"/>
                    </controls:TabViewItem.IconSource>
                    <tabs:Base64Tab Margin="20"/>
                </controls:TabViewItem>

                <controls:TabViewItem x:Name="NameCaseTabItem" Header="字段命名转换" IsClosable="False">
                    <controls:TabViewItem.IconSource>
                        <controls:SymbolIconSource Symbol="Rename"/>
                    </controls:TabViewItem.IconSource>
                    <tabs:NameCaseTab Margin="20"/>
                </controls:TabViewItem>

                <controls:TabViewItem x:Name="BackupTabItem" Header="文件备份" IsClosable="False">
                    <controls:TabViewItem.IconSource>
                        <controls:SymbolIconSource Symbol="Copy"/>
                    </controls:TabViewItem.IconSource>
                    <tabs:BackupTab Margin="20"/>
                </controls:TabViewItem>

                <controls:TabViewItem x:Name="ExtractTabItem" Header="文件解压" IsClosable="False">
                    <controls:TabViewItem.IconSource>
                        <controls:SymbolIconSource Symbol="Folder"/>
                    </controls:TabViewItem.IconSource>
                    <tabs:ExtractTab Margin="20"/>
                </controls:TabViewItem>
            </controls:TabView.TabItems>
        </controls:TabView>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="UsefulTools"
            MenuActivation="RightClick"
            NoLeftClickDelay="True"
            LeftClickCommand="{x:Bind ReopenWindowCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource
                    Text="&#xE90F;"
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="White"
                    Background="#FF1F6FEB"
                    FontSize="80"/>
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                    <MenuFlyoutItem Text="打开 base64解码" Command="{x:Bind OpenBase64TabCommand}"/>
                    <MenuFlyoutItem Text="打开 字段命名转换" Command="{x:Bind OpenNameCaseTabCommand}"/>
                    <MenuFlyoutItem Text="打开 文件备份" Command="{x:Bind OpenBackupTabCommand}"/>
                    <MenuFlyoutItem Text="打开 文件解压" Command="{x:Bind OpenExtractTabCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="退出" Command="{x:Bind ExitCommand}"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
